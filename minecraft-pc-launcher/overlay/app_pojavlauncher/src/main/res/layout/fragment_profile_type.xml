<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Installation"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose a Minecraft Java Edition profile or mod loader to install."
            android:textColor="#B5BEB4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="VANILLA AND UTILITY"
            android:textColor="#DCE9D8"
            android:textSize="11sp"
            android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="#3A4239" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/vanilla_profile"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Vanilla Java"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/optifine_profile"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_edit"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="OptiFine"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_modded_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="MOD LOADERS"
            android:textColor="#DCE9D8"
            android:textSize="11sp"
            android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" />

        <View
            android:id="@+id/view_modded"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="#3A4239" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_fabric"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Fabric"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_forge"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Forge"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_neoforge"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_java_run"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="NeoForge"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_quilt"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_book"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Quilt"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_legacy_fabric"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_book"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Legacy Fabric"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_bta"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Better Than Adventure"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/modded_profile_modpack"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/launcher_nav_item_bg"
            android:drawableStart="@drawable/ic_px_folder"
            android:drawablePadding="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:text="Modpack"
            android:textAllCaps="false"
            android:textColor="#F1F1F1"
            android:textSize="14sp" />

    </LinearLayout>
</com.kdt.DefocusableScrollView>
